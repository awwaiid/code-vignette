// In composeApp/build.gradle.kts, inside `kotlin { sourceSets { ... } }`,
// add one line to the androidMain.dependencies block:

androidMain.dependencies {
    // ... existing entries unchanged ...
    implementation(libs.play.services.wearable)   // <-- ADD
}


// Then, in gradle/libs.versions.toml, register the dependency in BOTH the
// [versions] and [libraries] tables:

// [versions]
// ... existing entries ...
play-services-wearable = "18.2.0"

// [libraries]
// ... existing entries ...
play-services-wearable = { group = "com.google.android.gms", name = "play-services-wearable", version.ref = "play-services-wearable" }


// (If you'd rather not touch the version catalog, you can inline it instead:
//   implementation("com.google.android.gms:play-services-wearable:18.2.0")
// The catalog form keeps it consistent with the rest of the build.)
